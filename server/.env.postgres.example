# Local-only example credentials matching compose.postgres.yml.
# Set these in PowerShell, or copy this file to .env.postgres.local and load it
# explicitly. Tooling does NOT load .env or fall back to DATABASE_URL/MONGO_URI.
RAY_LOCAL_DATABASE_URL=postgresql://ray_local:ray_local_only@127.0.0.1:55432/ray_local
RAY_TEST_DATABASE_URL=postgresql://ray_test:ray_test_only@127.0.0.1:55433/ray_test
