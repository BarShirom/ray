{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "npm run build && node dist/db/migrate-local.js",
    "test:postgres": "npm run build && node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "dev:postgres": "tsx watch preview-server.ts",
    "start:postgres": "node dist/preview-server.js",
    "db:migrate:preview": "npm run build && node dist/db/migrate-preview.js",
    "db:seed:preview": "npm run build && node dist/db/seed-preview.js",
    "media:cleanup": "npm run build && node dist/media/cleanup.js",
    "test:s3:live": "npm run build && node tests/live/s3.mjs"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1138.0",
    "@aws-sdk/client-sts": "3.1138.0",
    "@aws-sdk/credential-providers": "3.1138.0",
    "@aws-sdk/s3-request-presigner": "3.1138.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "drizzle-orm": "0.45.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.1",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "pg": "8.23.0",
    "sharp": "0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
