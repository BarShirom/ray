{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndExactCleanup",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::ray-media-438298964276-eu-north-1-an/dev/*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "ImmutableEncryptedWrites",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::ray-media-438298964276-eu-north-1-an/dev/*",
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        },
        "StringEquals": {
          "s3:x-amz-server-side-encryption": "AES256",
          "s3:if-none-match": "*"
        }
      }
    }
  ]
}
